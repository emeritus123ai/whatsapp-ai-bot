# Copy these into Render's Environment Variables settings — never commit real values.

# Make up any random secret word/phrase yourself. You'll type this same value
# into Meta's "Verify token" field later.
VERIFY_TOKEN=choose-a-secret-word

# Your PERMANENT System User access token from Business Settings > System Users
WHATSAPP_TOKEN=your-permanent-token-here

# From WhatsApp > API Setup page in your Meta App
PHONE_NUMBER_ID=your-phone-number-id-here

# From console.groq.com > API Keys (free account)
GROQ_API_KEY=your-groq-api-key-here

# Optional: customize how the AI behaves/responds
SYSTEM_PROMPT=You are a friendly, helpful customer service assistant for a business on WhatsApp. Keep replies short (2-4 sentences), warm, and clear.
